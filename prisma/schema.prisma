// Arc — git-native project management
// Hierarchy: Organization → Project → Epic → Issue → Subtask

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────── identity

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarHue     Int       @default(285)
  githubLogin   String?
  githubId      String?   @unique
  /// OAuth token used to list repos and import issues. Encrypt at rest in production.
  githubToken   String?
  /// Only issued when the GitHub App expires user tokens; absent for OAuth Apps.
  githubRefreshToken    String?
  /// Null means the token never expires, which is how OAuth Apps behave.
  githubTokenExpiresAt  DateTime?
  /// Once this passes, the person has to reconnect GitHub by hand.
  githubRefreshExpiresAt DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  memberships    Membership[]
  teamMembers    TeamMember[]
  assignedIssues Issue[]          @relation("assignee")
  createdIssues  Issue[]          @relation("creator")
  subtasks       Subtask[]
  comments       Comment[]
  activities     Activity[]
  watches        Watcher[]
  notifications  Notification[]
  sentInvites    Invite[]         @relation("inviter")
  tokens         ApiToken[]
  apiRuns        ApiRun[]
  taskLists      TaskList[]
  tasks          Task[]             @relation("taskOwner")
  delegatedTasks Task[]             @relation("taskDelegator")
  /// True for the member row behind an assistant, so the UI can mark it.
  isAgent        Boolean          @default(false)
  assistant      Assistant?
  focusSessions  FocusSession[]
  focusPref      FocusPref?
  attachments    Attachment[]
  prefs          NotificationPref?
  magicLinks     MagicLink[]

  @@index([githubLogin])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A single-use sign-in link. `token` holds a SHA-256 hash, never the value
/// that was emailed, so a database leak can't be used to sign in as anyone.
model MagicLink {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectTo String?
  requestIp  String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────── org

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  /// Master switch for the MCP server. Off means no assistant can connect.
  aiAccess     Boolean  @default(true)
  epicCounter  Int      @default(0)
  githubOrg    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members      Membership[]
  teams        Team[]
  projects     Project[]
  invites      Invite[]
  milestones   Milestone[]
  activities   Activity[]
  integrations Integration[]
  rules        AutomationRule[]
  tokens       ApiToken[]
  tasks        Task[]
  assistants   Assistant[]
}

model Membership {
  id        String       @id @default(cuid())
  role      Role         @default(MEMBER)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Team {
  id      String       @id @default(cuid())
  name    String
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([orgId, name])
}

model TeamMember {
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Invite {
  id         String       @id @default(cuid())
  email      String
  role       Role         @default(MEMBER)
  token      String       @unique
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy  User?        @relation("inviter", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([orgId, email])
  @@index([orgId])
}

// ─────────────────────────────────────────── projects

model Project {
  id           String       @id @default(cuid())
  name         String
  key          String
  color        String       @default("lime")
  repoFullName String?
  issueCounter Int          @default(0)
  archived     Boolean      @default(false)
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  issues       Issue[]
  epics        Epic[]
  sprints      Sprint[]
  labels       Label[]
  roadmapPage  RoadmapPage?
  collections  ApiCollection[]
  environments ApiEnvironment[]
  apiRuns      ApiRun[]

  @@unique([orgId, key])
  @@index([orgId])
}

enum EpicStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model Epic {
  id          String     @id @default(cuid())
  key         String
  name        String
  description String?
  color       String     @default("lime")
  status      EpicStatus @default(PLANNED)
  startDate   DateTime?
  targetDate  DateTime?
  /// Internal epics stay internal — nothing is public until it's chosen.
  publicVisible Boolean  @default(false)
  /// Plain wording for outsiders; falls back to the internal description.
  publicSummary String?
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  issues Issue[]

  @@unique([projectId, key])
  @@index([projectId])
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id              String       @id @default(cuid())
  name            String
  number          Int
  status          SprintStatus @default(PLANNED)
  startDate       DateTime
  endDate         DateTime
  capacity        Int          @default(40)
  committedPoints Int          @default(0)
  completedAt     DateTime?
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  issues Issue[]

  @@unique([projectId, number])
  @@index([projectId])
}

model Label {
  id        String  @id @default(cuid())
  name      String
  color     String  @default("slate")
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues IssueLabel[]

  @@unique([projectId, name])
}

enum IssueStatus {
  TRIAGE
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Issue {
  id          String      @id @default(cuid())
  number      Int
  key         String
  title       String
  description String?
  status      IssueStatus @default(TRIAGE)
  priority    Priority    @default(NONE)
  estimate    Int?
  rank        Float       @default(0)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  epicId String?
  epic   Epic?   @relation(fields: [epicId], references: [id], onDelete: SetNull)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("creator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels        IssueLabel[]
  subtasks      Subtask[]
  comments      Comment[]
  activities    Activity[]
  watchers      Watcher[]
  notifications Notification[]
  branches      GitBranch[]
  pullRequests  PullRequest[]
  blocks        IssueLink[]    @relation("blocker")
  blockedBy     IssueLink[]    @relation("blocked")
  apiFailures   ApiRunResult[]
  fileRefs      IssueFileRef[]
  attachments   Attachment[]
  taskRefs      Task[]         @relation("taskContext")
  focusSessions FocusSession[] @relation("focusContext")

  @@unique([projectId, number])
  @@index([key])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([epicId])
}

model IssueLabel {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

// blocker blocks blocked
model IssueLink {
  id        String @id @default(cuid())
  blockerId String
  blocker   Issue  @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Issue  @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Subtask {
  id         String    @id @default(cuid())
  title      String
  done       Boolean   @default(false)
  position   Float     @default(0)
  issueId    String
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([issueId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  automated Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  attachments Attachment[]
}

model Watcher {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
}

// ─────────────────────────────────────────── git

model GitBranch {
  id        String   @id @default(cuid())
  name      String
  repo      String
  commits   Int      @default(0)
  ahead     Int      @default(0)
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([repo, name])
  @@index([issueId])
}

enum PrState {
  DRAFT
  OPEN
  MERGED
  CLOSED
}

model PullRequest {
  id           String   @id @default(cuid())
  number       Int
  repo         String
  title        String
  url          String?
  state        PrState  @default(OPEN)
  checksPassed Int      @default(0)
  checksFailed Int      @default(0)
  approvals    Int      @default(0)
  branch       String?
  issueId      String
  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  mergedAt     DateTime?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([repo, number])
  @@index([issueId])
}

// ─────────────────────────────────────────── activity & inbox

enum ActivityType {
  ISSUE_CREATED
  ISSUE_UPDATED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  MENTIONED
  SUBTASK_DONE
  BRANCH_PUSHED
  PR_OPENED
  PR_MERGED
  CI_FAILED
  SPRINT_STARTED
  SPRINT_COMPLETED
  EPIC_CREATED
  PROJECT_CREATED
  MEMBER_JOINED
  BLOCKED
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  meta      Json?
  automatic Boolean      @default(false)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([issueId])
}

enum NotificationKind {
  MENTION
  ASSIGNED
  REVIEW_REQUESTED
  BLOCKING
  CI_FAILED
  COMMENT
  DUE_TODAY
  SPRINT
}

enum Urgency {
  BLOCKING
  TODAY
  LATER
}

model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind
  urgency   Urgency          @default(LATER)
  title     String
  detail    String?
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  archivedAt DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, archivedAt])
}

model NotificationPref {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMentions   Boolean @default(true)
  emailAssigned   Boolean @default(true)
  emailBlocking   Boolean @default(true)
  emailCiFailures Boolean @default(false)
  emailDigest     Boolean @default(true)
}

// ─────────────────────────────────────────── integrations

model Integration {
  id        String       @id @default(cuid())
  provider  String
  connected Boolean      @default(false)
  account   String?
  config    Json?
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([orgId, provider])
}

enum RuleTrigger {
  BRANCH_PUSHED
  PR_OPENED
  PR_MERGED
  CI_FAILED
  ISSUE_CREATED
}

enum RuleAction {
  SET_IN_PROGRESS
  SET_IN_REVIEW
  SET_DONE
  COMMENT_ON_ISSUE
  ADD_WATCHERS
  ASSIGN_TO_ACTOR
}

model AutomationRule {
  id        String       @id @default(cuid())
  trigger   RuleTrigger
  action    RuleAction
  enabled   Boolean      @default(true)
  label     String
  builtIn   Boolean      @default(false)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([orgId])
}

model ApiToken {
  id         String       @id @default(cuid())
  name       String
  prefix     String
  tokenHash  String       @unique
  lastUsedAt DateTime?
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  revokedAt  DateTime?

  @@index([orgId])
}

enum MilestoneStatus {
  ON_TRACK
  AT_RISK
  SHIPPED
}

model Milestone {
  id     String          @id @default(cuid())
  name   String
  date   DateTime
  status MilestoneStatus @default(ON_TRACK)
  orgId  String
  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model UsageCounter {
  id        String   @id @default(cuid())
  orgId     String
  month     String
  metric    String
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([orgId, month, metric])
}

// ─────────────────────────────────────────── api console

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

/// Where a collection came from. REPO collections are rebuilt from the
/// repository's /api folder and shouldn't be hand-edited.
enum CollectionSource {
  REPO
  MANUAL
}

model ApiCollection {
  id        String           @id @default(cuid())
  name      String
  source    CollectionSource @default(MANUAL)
  /// Path in the repo this folder was derived from, e.g. "src/app/api/issues".
  repoPath  String?
  position  Float            @default(0)
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  requests ApiRequest[]
  runs     ApiRun[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ApiRequest {
  id           String        @id @default(cuid())
  name         String
  method       HttpMethod    @default(GET)
  /// Appended to the environment's base URL, e.g. "/api/issues/:key".
  path         String
  body         String?
  headers      Json?
  params       Json?
  /// One assertion per line, e.g. `status == 200`.
  assertions   String?
  /// Send this one without the environment's auth — a login endpoint, say.
  skipAuth     Boolean       @default(false)
  position     Float         @default(0)
  collectionId String
  collection   ApiCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  results ApiRunResult[]

  @@index([collectionId])
}

enum EnvironmentKind {
  STATIC
  PR_PREVIEW
}

/// How an environment authenticates. Set once, applied to every request that
/// doesn't opt out.
enum ApiAuthType {
  NONE
  BEARER
  BASIC
  HEADER
  QUERY
}

model ApiEnvironment {
  id        String          @id @default(cuid())
  name      String
  baseUrl   String
  kind      EnvironmentKind @default(STATIC)
  prNumber  Int?
  color     String          @default("amber")
  /// Substituted into requests as $env.NAME.
  variables Json?

  authType     ApiAuthType @default(NONE)
  /// Bearer token, API key, or the password half of basic auth.
  authToken    String?
  authUsername String?
  /// Header or query-parameter name for HEADER / QUERY auth.
  authName     String?

  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  runs ApiRun[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ApiRun {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String?
  environment   ApiEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  collectionId  String?
  collection    ApiCollection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  triggeredById String?
  triggeredBy   User?           @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  passed     Int      @default(0)
  failed     Int      @default(0)
  p95Ms      Int      @default(0)
  requestCount Int    @default(0)
  createdAt  DateTime @default(now())

  results ApiRunResult[]

  @@index([projectId, createdAt])
}

model ApiRunResult {
  id        String      @id @default(cuid())
  runId     String
  run       ApiRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  requestId String?
  request   ApiRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  /// Snapshotted so a result stays readable after the request is edited.
  name       String
  method     HttpMethod
  url        String
  requestBody String?

  status       Int?
  statusText   String?
  durationMs   Int        @default(0)
  sizeBytes    Int        @default(0)
  responseBody String?
  responseHeaders Json?
  error        String?

  /// [{ source, ok, detail }]
  assertions   Json?
  passedCount  Int        @default(0)
  failedCount  Int        @default(0)

  /// Set when this failure was turned into an issue.
  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([issueId])
}

// ─────────────────────────────────────────── repo browser

/// A range of lines in a file that an issue is about. The mapping a git host
/// can't give you: which issues touch this file, and exactly where.
model IssueFileRef {
  id        String   @id @default(cuid())
  repo      String
  path      String
  startLine Int?
  endLine   Int?
  /// Branch or sha the range was captured against.
  ref       String?
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([repo, path])
  @@index([issueId])
}

// ─────────────────────────────────────────── tasks
//
// Deliberately not issues: private by default, no repo link, no points, no
// board column, and never counted toward velocity. Delegation is the one
// social part — a sent task lands on the recipient's Tasks page and nowhere
// else.

model TaskList {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("lime")
  position  Float    @default(0)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  tasks Task[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

enum TaskStatus {
  OPEN
  DONE
}

/// Where a delegated task stands. NONE means nobody sent it — it's just yours.
enum DelegationStatus {
  NONE
  PENDING
  ACCEPTED
  DECLINED
}

model Task {
  id              String     @id @default(cuid())
  title           String
  note            String?
  status          TaskStatus @default(OPEN)
  dueDate         DateTime?
  estimateMinutes Int?
  /// Hidden from Next up until this passes.
  snoozedUntil    DateTime?
  position        Float      @default(0)
  completedAt     DateTime?

  /// Whose Tasks page it lives on.
  ownerId String
  owner   User      @relation("taskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  listId  String?
  list    TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  delegatedById    String?
  delegatedBy      User?            @relation("taskDelegator", fields: [delegatedById], references: [id], onDelete: SetNull)
  delegationStatus DelegationStatus @default(NONE)
  delegationNote   String?
  declineReason    String?
  /// A counter-offer from the recipient, awaiting the sender's agreement.
  proposedDate     DateTime?
  canRenegotiate   Boolean          @default(true)
  delegatedAt      DateTime?
  respondedAt      DateTime?
  nudgedAt         DateTime?

  /// Context only — changing the task never changes the issue.
  issueId String?
  issue   Issue?  @relation("taskContext", fields: [issueId], references: [id], onDelete: SetNull)
  /// Set when the task was promoted onto a board and closed.
  convertedIssueId String?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtasks TaskSubtask[]
  focus    FocusSession[]

  @@index([ownerId, status])
  @@index([delegatedById])
  @@index([orgId])
}

model TaskSubtask {
  id       String  @id @default(cuid())
  title    String
  done     Boolean @default(false)
  position Float   @default(0)
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Time spent heads-down. Rolls up into "Focus this week" and nothing else.
enum FocusKind {
  FOCUS
  BREAK
}

model FocusSession {
  id        String    @id @default(cuid())
  kind      FocusKind @default(FOCUS)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A session can attach to an issue or a task — or to nothing at all.
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  issueId   String?
  issue     Issue?    @relation("focusContext", fields: [issueId], references: [id], onDelete: SetNull)

  plannedMinutes Int  @default(45)
  minutes   Int       @default(0)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Paused time is banked here so the remaining count survives a reload.
  pausedAt      DateTime?
  pausedSeconds Int      @default(0)

  /// Set when the user chose to log the session against its issue or task.
  loggedAt  DateTime?

  @@index([userId, startedAt])
  @@index([issueId])
}

/// Per-user timer settings — remembered between sessions.
model FocusPref {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastLengthMinutes  Int     @default(45)
  pauseNotifications Boolean @default(true)
  suggestBreak       Boolean @default(true)
  /// Off by default: focus time is personal unless you say otherwise.
  shareBadge         Boolean @default(false)

  updatedAt DateTime @updatedAt
}


// ─────────────────────────────────────────── public roadmap

enum RoadmapDetail {
  QUARTERS
  MONTHS
  DATES
}

/// The public face of a project's roadmap: a promise, not a schedule.
model RoadmapPage {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled  Boolean @default(false)
  headline String  @default("What we're building next")
  intro    String?

  detail        RoadmapDetail @default(QUARTERS)
  showShipped   Boolean       @default(true)
  showSubscribe Boolean       @default(true)
  /// Off by default — internal precision an outsider can't act on.
  showProgress  Boolean       @default(false)
  showIssues    Boolean       @default(false)
  showAssignees Boolean       @default(false)

  publishedAt DateTime?
  views       Int       @default(0)

  /// Digest of what visitors currently see; the change email fires when it moves.
  contentHash String?
  notifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscribers RoadmapSubscriber[]
  requests    RoadmapRequest[]
}

model RoadmapSubscriber {
  id     String      @id @default(cuid())
  pageId String
  page   RoadmapPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  email          String
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  /// SHA-256 of the confirm/unsubscribe token — the raw value only ever leaves by email.
  tokenHash      String    @unique

  createdAt DateTime @default(now())

  @@unique([pageId, email])
  @@index([pageId])
}

/// "Have a request? Tell us what's missing." — lands as a notification, not an inbox.
model RoadmapRequest {
  id     String      @id @default(cuid())
  pageId String
  page   RoadmapPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  email     String?
  body      String
  createdAt DateTime @default(now())

  @@index([pageId])
}


// ─────────────────────────────────────────── mcp server

enum AssistantLevel {
  READ_ONLY
  HELPER
  FULL
  CUSTOM
}

/// What an assistant may do with one tool.
enum ToolMode {
  ALLOW
  ASK
  DENY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// How a tool call ended, for "what it actually did".
enum AgentOutcome {
  AUTO
  APPROVED
  DENIED
  BLOCKED
  FAILED
  READ
}

/// One connected AI assistant. Its key is its identity; revoking keeps history.
model Assistant {
  id    String @id @default(cuid())
  name  String
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The member row its actions are attributed to — never an anonymous key.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level AssistantLevel @default(READ_ONLY)

  /// SHA-256 of the bearer token. The raw value is shown once, at creation.
  tokenHash   String  @unique
  /// Leading characters, so a key can be recognised without revealing it.
  tokenHint   String
  /// Which client it was set up for, for the right config snippet.
  client      String  @default("OTHER")

  /// Empty means every project in the org.
  projectIds  String[] @default([])
  ratePerHour Int      @default(200)
  /// Hours of silence before the key stops working. 0 means never.
  idleHours   Int      @default(8)

  enabled    Boolean   @default(true)
  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilities AssistantCapability[]
  approvals    AgentApproval[]
  actions      AgentAction[]

  @@index([orgId])
}

/// A per-tool override. Any row here means the assistant is CUSTOM.
model AssistantCapability {
  id          String    @id @default(cuid())
  assistantId String
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  tool        String
  mode        ToolMode

  @@unique([assistantId, tool])
  @@index([assistantId])
}

/// A write the assistant wants to make but isn't trusted to make alone.
model AgentApproval {
  id          String    @id @default(cuid())
  assistantId String
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  tool    String
  args    Json
  /// Plain-English description of what would happen.
  summary String

  status     ApprovalStatus @default(PENDING)
  decidedAt  DateTime?
  decidedById String?
  /// What the tool returned once it was allowed to run.
  result     Json?
  error      String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([assistantId, status])
}

/// The audit trail behind "what Claude did today". Outlives the key.
model AgentAction {
  id          String    @id @default(cuid())
  assistantId String
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  tool      String
  summary   String
  outcome   AgentOutcome
  targetKey String?
  createdAt DateTime     @default(now())

  @@index([assistantId, createdAt])
}


// ─────────────────────────────────────────── attachments

/// A file hanging off an issue, and optionally off one comment on it.
model Attachment {
  id       String @id @default(cuid())
  filename String
  mimeType String
  size     Int
  /// Path within the attachment store; never trusted from the client.
  storageKey String @unique

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  /// Set once the comment it was pasted into is posted.
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([issueId])
  @@index([commentId])
}

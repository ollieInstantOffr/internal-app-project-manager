# Required. `npm run init:env` generates this file with real values.
POSTGRES_PASSWORD="generate-with-openssl-rand-base64-32"
DATABASE_URL="postgresql://arc:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5434/arc?schema=public"

# App
# The public origin. Behind TLS in production, e.g.
# https://arc.internal.instantoffr.com
APP_URL="http://localhost:3321"
SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Arc <onboarding@resend.dev>"

# GitHub OAuth + webhooks (optional; app degrades gracefully without them)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Daily digest job — send as `Authorization: Bearer $CRON_SECRET` to /api/cron/digest
CRON_SECRET=""
ATTACHMENTS_DIR="./.attachments"
